<Window x:Class="RaftSaveEditor.App.AddItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adicionar item" Width="820" MinWidth="700" MinHeight="600" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="26,26,26,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Adicionar item" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="StorageText" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="Pesquisar na lista local — nome ou ID" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="ItemSearchTextBox" FontSize="16" TextChanged="ItemSearchTextBox_TextChanged"/>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="CategoryComboBox" SelectionChanged="CatalogFilter_Changed" ToolTip="Categoria do catálogo local"/>
                <ComboBox x:Name="ScopeComboBox" Grid.Column="2" SelectionChanged="CatalogFilter_Changed" ToolTip="Todos, favoritos ou usados recentemente"/>
                <Button x:Name="FavoriteButton" Grid.Column="3" Content="☆ Favoritar" Margin="10,0,0,0" Click="FavoriteButton_Click" IsEnabled="False"/>
                <Button Grid.Column="4" Content="Limpar filtros" Margin="8,0,0,0" Click="ClearFilters_Click"/>
            </Grid>
            <TextBlock x:Name="SearchResultText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,5,0,7"/>
            <ListBox x:Name="ItemComboBox" FontSize="15" Height="250"
                     SelectionChanged="ItemComboBox_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinWidth="680" Margin="2,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="160"/><ColumnDefinition Width="85"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Background="#101A28" CornerRadius="5" VerticalAlignment="Center">
                                <Image Source="{Binding IconPath}" Width="26" Height="26" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Type}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding StackSize, StringFormat=Qtd. máx. {0}}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding Id, StringFormat=ID {0}}" Foreground="#52647B" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Width="54" Height="54" Background="#101A28" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Image x:Name="ItemIcon" Width="46" Height="46" Stretch="Uniform"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="ItemNameText" Text="Selecione um item" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock x:Name="ItemTypeText" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="#101A28" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="QUANTIDADE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBox x:Name="AmountTextBox" Width="90" FontSize="18" FontWeight="SemiBold" Text="1"
                                 PreviewTextInput="NumericTextBox_PreviewTextInput" TextChanged="AmountTextBox_TextChanged" IsEnabled="False"/>
                        <TextBlock x:Name="AmountLimitText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="USES" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="UsesText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="SLOTS LIVRES" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="EmptySlotsText" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="LiveBatchPanel" Grid.Row="4" Visibility="Collapsed" Background="#101A28"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,14,0,0">
            <StackPanel>
                <CheckBox x:Name="FillStorageCheckBox" Content="Encher todos os slots livres com o item selecionado"
                          Checked="FillStorageCheckBox_Changed" Unchecked="FillStorageCheckBox_Changed"/>
                <StackPanel x:Name="QueueBuilderPanel">
                    <TextBlock Text="Ou monte uma lista: cada item ocupará um slot livre com a quantidade escolhida e Uses máximo."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,8"/>
                    <Button x:Name="QueueItemButton" Content="Adicionar item selecionado à lista" HorizontalAlignment="Left"
                            IsEnabled="False" Click="QueueItem_Click"/>
                    <ListBox x:Name="QueuedItemsList" Height="150" Margin="0,10,0,0" BorderThickness="0"
                             Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Image Source="{Binding IconPath}" Width="27" Height="27" Stretch="Uniform"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0,0,0">
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Text="{Binding Id, StringFormat= · ID {0}}" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="Qtd." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Width="62"
                                                 PreviewTextInput="NumericTextBox_PreviewTextInput" LostFocus="QueuedAmount_LostFocus"/>
                                        <TextBlock Text="{Binding MaxAmount, StringFormat=/ {0}}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="Remover" Style="{StaticResource LinkButton}" Click="RemoveQueuedItem_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="QueueStatusText" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ValidationText" Grid.Row="5" Foreground="#FF7B72" Margin="0,14,0,0" TextWrapping="Wrap"/>

    </Grid>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="26,14,26,20">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ActionSummaryText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                <Button Grid.Column="1" Content="Cancelar" IsCancel="True" MinWidth="105" Margin="0,0,8,0"/>
                <Button Grid.Column="2" x:Name="AddButton" Content="Aplicar" MinWidth="150" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" IsEnabled="False" Click="Add_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
